<?xml version="1.0"?>
<robot name="tracked_robot">

  <!-- Base -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.30 0.22 0.10"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </visual>
  </link>

  <!-- LiDAR frame -->
  <link name="laser"/>
  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <!-- TODO: update these measured values -->
    <origin xyz="0.12 0.00 0.10" rpy="0 0 0"/>
  </joint>

  <!-- IMU frame -->
  <link name="imu_link"/>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- TODO: update these measured values -->
    <origin xyz="0.00 0.00 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Stereo camera frame -->
  <link name="camera_link"/>
  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- TODO: update these measured values -->
    <origin xyz="0.15 0.00 0.12" rpy="0 0 0"/>
  </joint>

</robot>
